Vagrant.configure("2") do |config|

  config.vm.box = "centos/stream9"
  
  # VirtualBox Provider Configuration 
  config.vm.define "web" do |web|
    web.vm.hostname = "web"
    ## Customize the VM:
    web.vm.provider "virtualbox" do |vb|
      vb.name = "web-centos-9"
      vb.cpus = 1
      vb.memory = 512
    end
    ## Enable provisioning with a shell script 
    web.vm.provision "shell", path: "web_provision.sh"
    # Create a private network, which allows host-only access to the machine using a specific IP.
    web.vm.network "private_network", ip: " 192.168.56.10"
    web.vm.network "forwarded_port", guest: 80, host: 8080
    web.vm.synced_folder "./src/web_src", "/var/www/myapp"
  end
  config.vm.define "app" do |app|
    ## Display the VirtualBox GUI when booting the machine
    #   vb.gui = true
    ## Customize the VM:
    app.vm.hostname = "app"
    app.vm.provider "virtualbox" do |vb|
      vb.name = "app-centos-9"
      vb.cpus = 1
      vb.memory = 1024
    end
    ## Enable provisioning with a shell script 
    app.vm.provision "shell", inline: <<-SHELL
      dnf install -y python3 python3-pip
      pip3 install flask
      systemctl enable --now flask
    SHELL
    # Create a private network, which allows host-only access to the machine using a specific IP.
    app.vm.network "private_network", ip: " 192.168.56.11"
  end
  config.vm.define "db" do |db|
    ## Display the VirtualBox GUI when booting the machine
    #   vb.gui = true
    ## Customize the VM:
    db.vm.hostname = "db"
    db.vm.provider "virtualbox" do |vb|
      vb.name = "db-centos-9"
      vb.cpus = 2
      vb.memory = 2048
    end
    ## Customize the disk size:
    db.vm.disk :disk, size: "5GB", name: "pgdata"
    ## Enable provisioning with a shell script 
    db.vm.provision "shell", inline: <<-SHELL
      dnf install -y postgresql
      systemctl enable --now postgresql
    SHELL
    # Create a private network, which allows host-only access to the machine using a specific IP.
    db.vm.network "private_network", ip: " 192.168.56.12"
  end

  # Disable automatic box update checking
  config.vm.box_check_update = false

  # Share an additional folder to the guest VM
  #config.vm.synced_folder "./src", "/vagrant_data"

end
